# Solo para desarrollo local. Cambia estos valores antes de usar la aplicación.
SESSION_SECRET=replace-with-a-random-secret-of-at-least-64-characters
FIELD_ENCRYPTION_KEK=replace-with-64-hex-characters
DEV_OWNER_EMAIL=owner@example.test
DEV_OWNER_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:54329/revenia
MIGRATION_DATABASE_URL=postgresql://ADMIN:PASSWORD@127.0.0.1:54329/revenia
REDIS_URL=redis://:PASSWORD@127.0.0.1:6380
APP_DB_PASSWORD=replace-with-local-app-password
POSTGRES_PASSWORD=replace-with-local-admin-password
REDIS_PASSWORD=replace-with-local-redis-password

# Motores: sin envíos ni llamadas externas hasta activación expresa.
EXTERNAL_OPERATIONS_ENABLED=false
WORKER_TENANT_IDS=replace-with-a-tenant-uuid
ENGINE_DAILY_LIMIT=100
APP_URL=http://localhost:3000

# Platform subscriptions: separate from each company invoice Stripe connection.
# Leave disabled until operator binding, prices and provider tests are complete.
PLATFORM_BILLING_ENABLED=false
PLATFORM_BILLING_MODE=test
PLATFORM_BILLING_ALLOW_LIVE=false
PLATFORM_STRIPE_SECRET_KEY=
PLATFORM_STRIPE_WEBHOOK_SECRET=
PLATFORM_STRIPE_PRICES=[]
# Production always requires a configured subscription for engine execution.
BILLING_REQUIRED=false

# Recuperacion: mailpit local; resend requiere activacion y remitente verificado.
RECOVERY_MAIL_PROVIDER=mailpit
RECOVERY_RESEND_API_KEY=
RECOVERY_FROM=
