{
  "name": "revenia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-isolation=none --experimental-transform-types src/lib/security/security.test.ts src/lib/security/deployment.test.ts src/lib/domain/tenant-isolation.test.ts",
    "test:security": "npm run test",
    "test:integration": "node --env-file=.env.local --test --test-isolation=none --experimental-transform-types src/lib/db/database.integration.test.ts src/lib/redis/redis.integration.test.ts",
    "db:migrate": "node --env-file=.env.local --experimental-transform-types src/scripts/migrate.ts",
    "db:seed": "node --env-file=.env.local --experimental-transform-types src/scripts/seed.ts",
    "test:all": "npm run typecheck && npm run lint && npm run test && npm run build",
    "test:all:docker": "npm run test:all && npm run test:contracts && npm run test:integration && npm run test:engines && npm run test:accounts && npm run test:audit && npm run test:billing && npm run test:billing:sync && npm run test:billing:notifications && npm run test:invoices",
    "test:audit": "node --env-file=.env.local --test --test-isolation=none --experimental-transform-types src/lib/db/audit.integration.test.ts",
    "test:accounts": "node --env-file=.env.local --test --test-isolation=none --experimental-transform-types src/lib/auth/account.integration.test.ts",
    "test:engines": "node --env-file=.env.local --test --test-isolation=none --experimental-transform-types src/lib/engines/engines.test.ts src/lib/engines/signatures.test.ts src/lib/engines/queue.integration.test.ts",
    "check:deployment": "node --experimental-transform-types src/scripts/check-deployment.ts",
    "worker": "node --experimental-transform-types src/scripts/worker.ts",
    "worker:local": "node --env-file=.env.local --experimental-transform-types src/scripts/worker.ts",
    "test:billing": "node --env-file=.env.local --test --test-isolation=none --experimental-transform-types src/lib/billing/stripe-platform.test.ts src/lib/billing/usage.integration.test.ts",
    "test:billing:sync": "node --env-file=.env.local --test --test-isolation=none --experimental-transform-types src/lib/billing/reconcile.integration.test.ts",
    "test:billing:notifications": "node --env-file=.env.local --test --test-isolation=none --experimental-transform-types src/lib/billing/notifications.integration.test.ts",
    "ops:doctor": "node ops/revenia.mjs doctor",
    "ops:verify": "node ops/revenia.mjs verify",
    "ops:prepare": "node ops/revenia.mjs prepare",
    "test:ops": "node --test --test-isolation=none ops/release-files.test.mjs",
    "test:invoices": "node --env-file=.env.local --test --test-isolation=none --experimental-transform-types src/lib/engines/invoices.integration.test.ts",
    "test:lab": "node --test --test-isolation=none security-lab/lab.test.mjs",
    "recovery:mail:local": "node --env-file=.env.local --experimental-transform-types src/scripts/recovery-mail.ts",
    "test:portfolio": "node --env-file=.env.local --test --test-isolation=none --experimental-transform-types src/lib/domain/portfolio.integration.test.ts",
    "test:e2e": "node --env-file=.env.local node_modules/@playwright/test/cli.js test",
    "ops:restore-drill": "node --env-file=.env.local --experimental-transform-types ops/restore-drill.mjs",
    "test:contracts": "node --test --test-isolation=none --experimental-transform-types src/lib/api/openapi.test.ts"
  },
  "dependencies": {
    "next": "16.3.8",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "redis": "6.2.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.8",
    "typescript": "5.9.3"
  }
}
